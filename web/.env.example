# `neon deploy` / `neon env pull` writes the Neon variables into .env.local.
# Leave DATABASE_URL unset to run on the bundled sample data in demo/gpu_index.json.
DATABASE_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=          # server only: never NEXT_PUBLIC_
NEON_BRANCH_ID=                # with NEON_FUNCTION_HOST_SUFFIX, builds the history function URL
NEON_FUNCTION_HOST_SUFFIX=
# Browser copy of the Realtime URL (Next.js expands $VAR in env files)
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL
