# Supabase project (Settings -> API). The service-role key bypasses RLS: keep it server-side only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated gpuhunt providers. Default: the offline catalog providers (no API keys needed).
# Online providers (vastai, crusoe, digitalocean, ...) need their own keys and churn a lot; add them deliberately.
# GPUHUNT_PROVIDERS=aws,azure,gcp,lambdalabs,nebius,oci,runpod,verda,cloudrift

# Nosana host-manager API (public, read-only endpoints)
# NOSANA_API_URL=https://host-manager.k8s.prd.nosana.com
