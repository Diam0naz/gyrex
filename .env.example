# Neon (pooled) connection string: `neon env pull` writes it, or Neon Console -> Connect.
# The collector writes through Neon's SQL-over-HTTP endpoint, so only outbound HTTPS is needed.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Direct (unpooled) string, for migrations: python -m gyrex.migrate
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# Comma-separated gpuhunt providers. Default: the offline catalog providers (no API keys needed).
# GPUHUNT_PROVIDERS=aws,azure,gcp,lambdalabs,nebius,oci,runpod,verda,cloudrift

# Nosana host-manager API (public, read-only endpoints)
# NOSANA_API_URL=https://host-manager.k8s.prd.nosana.com
